# Скопируйте в .env и поменяйте при необходимости
DATABASE_URL="file:./dev.db"
PORT=3000
# Секрет для подписи токенов. В проде обязательно свой длинный случайный
JWT_SECRET="change-me"
# Вход выбором пользователя без пароля. Только для разработки и мока!
ALLOW_DEV_LOGIN=true
# Откуда доска может ходить на сервер (через запятую)
CORS_ORIGINS="http://localhost:5173,https://lohengrin14.github.io"
