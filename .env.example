# Скопируйте в .env и поменяйте при необходимости
# Локально нужен Postgres, проще всего через Docker:
#   docker run -d --name pet-jira-db -e POSTGRES_HOST_AUTH_METHOD=trust -p 5432:5432 postgres:16
#   docker exec pet-jira-db createdb -U postgres petjira && docker exec pet-jira-db createdb -U postgres petjira_test
DATABASE_URL="postgresql://postgres@localhost:5432/petjira"
PORT=3000
# Секрет для подписи токенов. В проде обязательно свой длинный случайный
JWT_SECRET="change-me"
# Вход через Google: OAuth Client ID из Google Cloud Console (APIs & Services → Credentials).
# Без него кнопка «Войти через Google» не показывается
GOOGLE_CLIENT_ID=""
# Эти email при входе через Google становятся ADMIN (через запятую)
ADMIN_EMAILS="kocuxun@gmail.com"
# Вход выбором тестового пользователя без пароля (кроме ADMIN и Google-аккаунтов). Только для мока!
ALLOW_DEV_LOGIN=true
# Откуда доска может ходить на сервер (через запятую)
CORS_ORIGINS="http://localhost:5173,https://lohengrin14.github.io"
