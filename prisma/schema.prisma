// Схема базы Pet Jira. После изменения: npm run db:migrate -- --name <что_поменяли>

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  ADMIN // всё, включая управление пользователями и ролями
  MANAGER // всё с задачами и проектами, без управления пользователями
  MEMBER // создаёт задачи, меняет только свои (автор или исполнитель), не удаляет
  VIEWER // только смотрит
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  REVIEW
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  googleId  String?  @unique
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())

  authoredTasks Task[]    @relation("TaskAuthor")
  assignedTasks Task[]    @relation("TaskAssignee")
  comments      Comment[]
}

model Project {
  id        Int      @id @default(autoincrement())
  key       String   @unique // короткий ключ для номеров задач, например PJ1 → PJ1-12
  name      String
  color     String   @default("#6366f1")
  taskCount Int      @default(0) // счётчик для номеров задач внутри проекта
  createdAt DateTime @default(now())

  tasks Task[]
}

model Task {
  id          Int        @id @default(autoincrement())
  number      Int // номер внутри проекта: ключ задачи = Project.key + "-" + number
  title       String
  description String     @default("")
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  projectId  Int
  project    Project   @relation(fields: [projectId], references: [id])
  authorId   Int
  author     User      @relation("TaskAuthor", fields: [authorId], references: [id])
  assigneeId Int?
  assignee   User?     @relation("TaskAssignee", fields: [assigneeId], references: [id])
  comments   Comment[]

  @@unique([projectId, number])
}

model Comment {
  id        Int      @id @default(autoincrement())
  text      String
  createdAt DateTime @default(now())

  taskId   Int
  task     Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId Int
  author   User @relation(fields: [authorId], references: [id])
}
